{
  "name": "@eightmedia/flightcheck",
  "version": "1.3.0",
  "description": "Pre-launch website audit: crawl SEO/a11y/security checks and emit structured JSON + Markdown reports.",
  "license": "GPL-3.0",
  "type": "module",
  "author": "EightMedia <info@eight.nl>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EightMedia/flightcheck.git"
  },
  "bugs": {
    "url": "https://github.com/EightMedia/flightcheck/issues"
  },
  "homepage": "https://github.com/EightMedia/flightcheck#readme",
  "keywords": [
    "flightcheck",
    "crawler",
    "seo",
    "accessibility",
    "security",
    "audit",
    "pre-launch",
    "cli"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./checks": {
      "types": "./dist/checks/index.d.ts",
      "import": "./dist/checks/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "flightcheck": "dist/cli.js",
    "flightcheck-analyze": "dist/analyze.js"
  },
  "files": [
    "dist",
    "!dist/orchestrate.js",
    "!dist/orchestrate/**",
    "!dist/orchestrate.d.ts",
    "!dist/orchestrate.d.ts.map",
    "docs/*.md",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "tsx src/cli.ts --help",
    "flightcheck": "tsx src/cli.ts",
    "crawl": "tsx src/cli.ts",
    "analyze": "tsx src/analyze.ts",
    "build": "tsc",
    "prepublishOnly": "pnpm test && pnpm build",
    "start": "node dist/cli.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "commander": "^15.1.0",
    "crawlee": "^3.18.2",
    "pino": "^10.4.0",
    "robots-parser": "^3.1.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  },
  "packageManager": "pnpm@11.29.0+sha512.d913f9b37cd5fe6780052e809774edabb7bdcf69a6e6d9b8fd3b38bc052fa8a7d891b6c201a38fb504a07ffce2e5e8c262ef54fb8f57db62f22d353a30bc8a96"
}
