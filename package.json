{
  "name": "@eightmedia/flightcheck",
  "version": "0.1.0",
  "type": "module",
  "license": "GPL-3.0",
  "description": "Website pre-launch crawler: verifies SEO/metadata/tracking and scans for exposed API keys and secrets.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EightMedia/flightcheck.git"
  },
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./checks": "./dist/checks/index.js"
  },
  "bin": {
    "flightcheck": "dist/cli.js",
    "flightcheck-analyze": "dist/analyze.js"
  },
  "files": [
    "dist",
    "data/webappanalyzer",
    "docs/*.md",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "tsx src/cli.ts --help",
    "flightcheck": "tsx src/cli.ts",
    "crawl": "tsx src/cli.ts",
    "analyze": "tsx src/analyze.ts",
    "build": "tsc",
    "prepublishOnly": "tsc",
    "start": "node dist/cli.js",
    "sync:webappanalyzer": "node scripts/sync-webappanalyzer.mjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "cheerio": "^1.1.2",
    "commander": "^14.0.1",
    "crawlee": "^3.15.0",
    "pino": "^10.1.0",
    "robots-parser": "^3.0.1",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.1.9"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@11.5.2+sha512.71c631e382066efc25625d5cf029075de07b61b37f6e27350fbd84b1bda5864c8c1967adc280776b45c30a715c0359a3be08fef42d5bb09e2b99029979692916"
}
