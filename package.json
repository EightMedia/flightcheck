{
  "name": "@eightmedia/flightcheck",
  "version": "1.0.1",
  "description": "Pre-launch website audit: crawl SEO/a11y/security checks and emit structured JSON + Markdown reports.",
  "license": "GPL-3.0",
  "type": "module",
  "author": "EightMedia <info@eight.nl>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EightMedia/flightcheck.git"
  },
  "bugs": {
    "url": "https://github.com/EightMedia/flightcheck/issues"
  },
  "homepage": "https://github.com/EightMedia/flightcheck#readme",
  "keywords": [
    "flightcheck",
    "crawler",
    "seo",
    "accessibility",
    "security",
    "audit",
    "pre-launch",
    "cli"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./checks": {
      "types": "./dist/checks/index.d.ts",
      "import": "./dist/checks/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "flightcheck": "dist/cli.js",
    "flightcheck-analyze": "dist/analyze.js"
  },
  "files": [
    "dist",
    "!dist/orchestrate.js",
    "!dist/orchestrate/**",
    "!dist/orchestrate.d.ts",
    "!dist/orchestrate.d.ts.map",
    "docs/*.md",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "tsx src/cli.ts --help",
    "flightcheck": "tsx src/cli.ts",
    "crawl": "tsx src/cli.ts",
    "analyze": "tsx src/analyze.ts",
    "build": "tsc",
    "prepublishOnly": "pnpm test && pnpm build",
    "start": "node dist/cli.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "cheerio": "^1.1.2",
    "commander": "^14.0.1",
    "crawlee": "^3.15.0",
    "pino": "^10.1.0",
    "robots-parser": "^3.0.1",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.1.9"
  },
  "packageManager": "pnpm@11.5.2+sha512.71c631e382066efc25625d5cf029075de07b61b37f6e27350fbd84b1bda5864c8c1967adc280776b45c30a715c0359a3be08fef42d5bb09e2b99029979692916"
}
