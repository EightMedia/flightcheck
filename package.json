{
  "name": "@eightmedia/flightcheck",
  "version": "1.2.1",
  "description": "Pre-launch website audit: crawl SEO/a11y/security checks and emit structured JSON + Markdown reports.",
  "license": "GPL-3.0",
  "type": "module",
  "author": "EightMedia <info@eight.nl>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EightMedia/flightcheck.git"
  },
  "bugs": {
    "url": "https://github.com/EightMedia/flightcheck/issues"
  },
  "homepage": "https://github.com/EightMedia/flightcheck#readme",
  "keywords": [
    "flightcheck",
    "crawler",
    "seo",
    "accessibility",
    "security",
    "audit",
    "pre-launch",
    "cli"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./checks": {
      "types": "./dist/checks/index.d.ts",
      "import": "./dist/checks/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "flightcheck": "dist/cli.js",
    "flightcheck-analyze": "dist/analyze.js"
  },
  "files": [
    "dist",
    "!dist/orchestrate.js",
    "!dist/orchestrate/**",
    "!dist/orchestrate.d.ts",
    "!dist/orchestrate.d.ts.map",
    "docs/*.md",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "tsx src/cli.ts --help",
    "flightcheck": "tsx src/cli.ts",
    "crawl": "tsx src/cli.ts",
    "analyze": "tsx src/analyze.ts",
    "build": "tsc",
    "prepublishOnly": "pnpm test && pnpm build",
    "start": "node dist/cli.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "commander": "^14.0.3",
    "crawlee": "^3.18.2",
    "pino": "^10.4.0",
    "robots-parser": "^3.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  },
  "packageManager": "pnpm@11.28.13+sha512.d5caa9cdcd6067ac2902f9f44daa00b1288a73babf1e98f4f375b3a7583b1894b4d49f7527da8f5e1530198bb10e03adba321a1f015429dc2946ce8a7a9a8c65"
}
